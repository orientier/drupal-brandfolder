{#
/**
 * @file
 * Default theme implementation for a Brandfolder Browser.
 *
 * Available variables:
 * - bf_browser_id: HTML attributes for the containing element.
 * - browser_settings: Array of optional settings for the browser.
 *
 * @ingroup themeable
 */
#}
{{ attach_library('brandfolder/brandfolder-browser') }}
<brandfolder-browser bf-browser-id="{{ bf_browser_id }}" settings="{{ browser_settings | json_encode }}"></brandfolder-browser>
